---
/* Standalone legal page (privacy / terms) for one language. Self-contained
   head (fonts + reset) as before, now with canonical, hreflang pair, OG/Twitter
   and a WebPage + BreadcrumbList graph. Body is the prose from legal.ts. */
import { OG_LOCALE, otherLang, type Lang } from './i18n'
import { ROUTES, SITE } from './i18n/routes'
import { DOCS, pageHtml, type Doc } from '../legal/legal'
import { legalGraph } from '../seo/schema'

interface Props {
  doc: Doc
  lang: Lang
}
const { doc, lang } = Astro.props
const c = DOCS[doc][lang]
const canonical = SITE + ROUTES[doc][lang]
const ogImage = `${SITE}/assets/img/og-cover.jpg`
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{c.metaTitle}</title>
    <meta name="description" content={c.metaDescription} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#FAF7F2" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={SITE + ROUTES[doc].es} />
    <link rel="alternate" hreflang="en" href={SITE + ROUTES[doc].en} />
    <link rel="alternate" hreflang="x-default" href={SITE + ROUTES[doc].es} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NexaDigit" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={c.metaTitle} />
    <meta property="og:description" content={c.metaDescription} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.metaTitle} />
    <meta name="twitter:description" content={c.metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(legalGraph(doc, lang))}></script>

    <link rel="icon" href="/assets/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />

    <link rel="preload" href="/assets/fonts/source-serif-4.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin />

    <style is:inline>
      @font-face { font-family: 'Schibsted Grotesk'; src: url('/assets/fonts/schibsted-grotesk.woff2') format('woff2'); font-weight: 400 700; font-display: swap; }
      @font-face { font-family: 'Source Serif 4'; src: url('/assets/fonts/source-serif-4.woff2') format('woff2'); font-weight: 400 500; font-display: swap; }
      @font-face { font-family: 'IBM Plex Mono'; src: url('/assets/fonts/ibm-plex-mono-400.woff2') format('woff2'); font-weight: 400; font-display: swap; }
      @font-face { font-family: 'IBM Plex Mono'; src: url('/assets/fonts/ibm-plex-mono-500.woff2') format('woff2'); font-weight: 500; font-display: swap; }
      @font-face { font-family: 'IBM Plex Mono'; src: url('/assets/fonts/ibm-plex-mono-600.woff2') format('woff2'); font-weight: 600; font-display: swap; }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      html, body { margin: 0; }
      body {
        background: #FAF7F2;
        color: #15171C;
        font-family: 'Source Serif 4', Georgia, serif;
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: #E04E14; color: #FAF7F2; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <div id="legal" set:html={pageHtml(doc, lang)}></div>
  </body>
</html>
